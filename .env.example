# Path to the SQLite knowledge database
OPTCG_DB_PATH=data/optcg.db

# Root directory for manual raw input files (rules, cards, faq, judge_chats)
OPTCG_RAW_DATA_DIR=data/raw

# Local sentence-transformers embedding model
# Options: BAAI/bge-m3 (1024 dims, runs in fp16 on 4GB VRAM) or intfloat/multilingual-e5-base (768 dims)
OPTCG_EMBEDDING_MODEL=BAAI/bge-m3

# Base URL for static punk-records JSON dataset (used by `optcg-ingest cards --source punk-records`)
OPTCG_PUNK_RECORDS_URL=https://raw.githubusercontent.com/buhbbl/punk-records/main/english
